{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": ".base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_TESTING": {"type": "BOOL", "value": "ON"},
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "CMAKE_CXX_STANDARD": {"type": "STRING", "value": "20"},
        "CMAKE_EXPORT_COMPILE_COMMANDS": {"type": "BOOL", "value": "ON"},
        "CMAKE_REQUIRE_FIND_PACKAGE_GTest": {"type": "BOOL", "value": "ON"},
        "VECGEOM_GDML": {"type": "BOOL", "value": "ON"},
        "VECGEOM_USE_SURF": {"type": "BOOL", "value": "OFF"}
      }
    },
    {
      "name": "executor",
      "displayName": "Executor base",
      "inherits": ".base",
      "environment": {
        "CMAKE_PREFIX_PATH": "$env{SPACK_ROOT}/var/spack/environments/celeritas-vglocal/.spack-env/view"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": {"type": "STRING", "value": "26"},
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "CMAKE_CXX_COMPILER_LAUNCHER": "/opt/homebrew/bin/ccache",
        "CMAKE_CXX_FLAGS": "-Wall -Wno-error=deprecated -pedantic -fdiagnostics-color=always",
        "VECGEOM_NAV": "index"
      }
    },
    {
      "name": "executor-v1",
      "displayName": "Executor with build options for v1-patches branch",
      "inherits": "executor",
      "cacheVariables": {
        "VECGEOM_USE_SURF": null,
        "VECGEOM_USE_NAVINDEX": {"type": "BOOL", "value": "ON"}
      }
    },
    {
      "name": "hudson-cuda",
      "displayName": "Hudson CUDA",
      "binaryDir": "/scratch/s3j/build/vecgeom-${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "VECGEOM_ENABLE_CUDA": {"type": "BOOL", "value": "ON"},
        "CMAKE_CUDA_ARCHITECTURES": {"type": "STRING", "value": "90"},
        "CMAKE_INSTALL_PREFIX": "/scratch/s3j/install/vecgeom-${presetName}"
      }
    }
  ]
}
